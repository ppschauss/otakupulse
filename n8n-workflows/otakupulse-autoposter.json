{
  "id": "otakupulseautoposter",
  "name": "OtakuPulse Autoposter",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyX",
              "value": 15,
              "unit": "minutes"
            }
          ]
        },
        "feedUrl": "http://otakupulse-app:3000/feed.xml"
      },
      "id": "rss-trigger",
      "name": "Neue Artikel (RSS)",
      "type": "n8n-nodes-base.rssFeedReadTrigger",
      "typeVersion": 1,
      "position": [
        -260,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "HIER_DISCORD_WEBHOOK_URL_EINTRAGEN",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: `**${$json.title}**\\n${$json.link}` }) }}",
        "options": {}
      },
      "id": "post-discord",
      "name": "→ Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        80,
        -120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://DEINE-INSTANZ.social/api/v1/statuses",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer HIER_MASTODON_ACCESS_TOKEN_EINTRAGEN"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: `${$json.title}\\n\\n${$json.link}` }) }}",
        "options": {}
      },
      "id": "post-mastodon",
      "name": "→ Mastodon",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        80,
        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://bsky.social/xrpc/com.atproto.server.createSession",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ identifier: 'DEIN-HANDLE.bsky.social', password: 'HIER_BLUESKY_APP_PASSWORT' }) }}",
        "options": {}
      },
      "id": "bsky-login",
      "name": "Bluesky: Login",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        80,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://bsky.social/xrpc/com.atproto.repo.createRecord",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.accessJwt }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ repo: $json.did, collection: 'app.bsky.feed.post', record: { $type: 'app.bsky.feed.post', text: $('Neue Artikel (RSS)').item.json.title, createdAt: $now.toISO(), embed: { $type: 'app.bsky.embed.external', external: { uri: $('Neue Artikel (RSS)').item.json.link, title: ($('Neue Artikel (RSS)').item.json.title || '').slice(0, 300), description: ($('Neue Artikel (RSS)').item.json.contentSnippet || '').slice(0, 280) } } } }) }}",
        "options": {}
      },
      "id": "bsky-post",
      "name": "→ Bluesky",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        220
      ]
    },
    {
      "parameters": {
        "resource": "post",
        "operation": "create",
        "subreddit": "OtakuPulse",
        "kind": "link",
        "title": "={{ $json.title }}",
        "url": "={{ $json.link }}"
      },
      "id": "post-reddit",
      "name": "→ Reddit",
      "type": "n8n-nodes-base.reddit",
      "typeVersion": 1,
      "position": [
        80,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/HIER_PAGE_ID/feed",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $json.title, link: $json.link, access_token: 'HIER_PAGE_ACCESS_TOKEN' }) }}",
        "options": {}
      },
      "id": "post-facebook",
      "name": "→ Facebook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        80,
        560
      ]
    }
  ],
  "connections": {
    "Neue Artikel (RSS)": {
      "main": [
        [
          {
            "node": "→ Discord",
            "type": "main",
            "index": 0
          },
          {
            "node": "→ Mastodon",
            "type": "main",
            "index": 0
          },
          {
            "node": "Bluesky: Login",
            "type": "main",
            "index": 0
          },
          {
            "node": "→ Reddit",
            "type": "main",
            "index": 0
          },
          {
            "node": "→ Facebook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Bluesky: Login": {
      "main": [
        [
          {
            "node": "→ Bluesky",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
