# Kopie nach secrets.env anlegen und ausfüllen (secrets.env ist gitignored, chmod 600).

# --- Telegram-Steuerpult (eigener Bot via @BotFather, NICHT @otakupulse_de_bot) ---
SOCIAL_BOT_TOKEN=123456:ABC-DEF...
# Chat, in dem die Freigabe-Batches ankommen. Leer lassen und einmal /start senden,
# um die Chat-ID automatisch zu registrieren (Bootstrap wandert dann in die DB).
SOCIAL_APPROVAL_CHAT_ID=

# --- KI-Formulierung ---
ANTHROPIC_API_KEY=sk-ant-...
# Modell (Standard: claude-sonnet-5). Für Reply-Triage später Haiku.
SOCIAL_MODEL=claude-sonnet-5

# --- Sicherheitsnetz: im Trockenmodus wird NICHTS wirklich gepostet ---
# 1 = dry-run (Standard, empfohlen für den ersten Start), 0 = echt posten.
DRY_RUN=1

# --- Postgres (NUR LESEND — Rolle social_ro) ---
PG_HOST=otakupulse-db
PG_PORT=5432
PG_DB=otakupulse
PG_USER=social_ro
PG_PASSWORD=HIER_SOCIAL_RO_PASSWORT

# --- Welche Kanäle aktiv sind (Komma-Liste). v1: bluesky,mastodon ---
CHANNELS_ENABLED=

# --- Bluesky (App-Passwort, NICHT Kontopasswort) ---
BLUESKY_HANDLE=DEIN-HANDLE.bsky.social
BLUESKY_APP_PASSWORD=HIER_BLUESKY_APP_PASSWORT
BLUESKY_PDS=https://bsky.social

# --- Mastodon (Access-Token aus Konto → Entwicklung → Neue Anwendung) ---
MASTODON_BASE_URL=https://DEINE-INSTANZ.social
MASTODON_ACCESS_TOKEN=HIER_MASTODON_ACCESS_TOKEN

# --- Feintuning (Defaults sind sinnvoll) ---
SITE_BASE_URL=https://www.otakupulse.de
BATCH_HOUR=18
BATCH_MINUTE=0
MAX_DRAFTS_PER_BATCH=6
PERISHABLE_HOURS=48

# --- Tumblr (Kanal, siehe docs/superpowers/specs/2026-11-02-tumblr-kanal-design.md) ---
# Consumer Key/Secret stammen aus der App unter https://www.tumblr.com/oauth/apps
TUMBLR_BLOG_IDENTIFIER=otakupulse-de.tumblr.com
TUMBLR_CONSUMER_KEY=
TUMBLR_CONSUMER_SECRET=
# OAuth-1.0a-Zugangstoken, einmalig beim Autorisieren erzeugt (Ablauf laut Doku ungeklaert;
# Begruendung der Verfahrenswahl im Kopf von app/channels/tumblr.py):
TUMBLR_OAUTH_TOKEN=
TUMBLR_OAUTH_TOKEN_SECRET=

# Sicherheitsnetz, kein Steuerinstrument: mehr Tumblr-Posts pro Tag (lokaler Tag) gehen nicht raus,
# der Rest verfaellt mit Telegram-Meldung. Leer oder kleiner 1 = Default 6.
TUMBLR_MAX_POSTS_PER_DAY=6

# Kanalweiser Trockenmodus: diese Kanaele posten NICHT, auch wenn DRY_RUN=0.
# Startwert, damit Tumblr allein live geht:
DRY_RUN_CHANNELS=bluesky,mastodon
