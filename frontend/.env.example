# Beispiel — echte Werte liegen auf Unraid in /mnt/cache/appdata/otakupulse/secrets.env
# und werden dem Container via --env-file übergeben. NICHT committen.

# PostgreSQL-Verbindung (intern über Docker-Netzwerk otakupulse-net)
DATABASE_URI=postgres://otaku:CHANGEME@otakupulse-db:5432/otakupulse

# Payload-Secret (zufällig generiert)
PAYLOAD_SECRET=CHANGEME
