# Vorlage für frontend/secrets.env (echte Datei ist gitignored, NIE committen).
# Kopieren:  cp secrets.env.example secrets.env  und Werte eintragen.

# --- PostgreSQL (db-Service) ---
POSTGRES_USER=otaku
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=otakupulse

# --- App (Payload + DB-Verbindung) ---
# Host = Container-/Servicename der DB (im Compose-Netz: otakupulse-db)
DATABASE_URI=postgres://otaku:CHANGE_ME@otakupulse-db:5432/otakupulse
PAYLOAD_SECRET=CHANGE_ME_LONG_RANDOM

# --- Optional: Reichweitenmessung (cookieless, nur nach Consent geladen) ---
# NEXT_PUBLIC_* müssen zusätzlich als Build-Args gesetzt werden (siehe docker-compose.yml),
# da sie in den Client-Bundle eingebacken werden.
# NEXT_PUBLIC_SITE_URL=https://deine-domain.tld
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=deine-domain.tld
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SRC=
