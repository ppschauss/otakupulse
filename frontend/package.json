{
  "name": "otakupulse",
  "version": "0.1.0",
  "description": "OtakuPulse — Anime-Datenbank & News (Next.js + Payload + PostgreSQL)",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -H 0.0.0.0 -p 3000",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev -H 0.0.0.0 -p 3000",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "import:anime": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/import-anime.ts",
    "import:batch": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/import-batch.ts",
    "import:tags": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/import-tags.ts",
    "backfill:languages": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/backfill-languages.ts",
    "sync": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/sync.ts",
    "mirror": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/mirror-images.ts",
    "translate": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/translate.ts",
    "news": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/generate-news.ts",
    "seed:navigation": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seed-navigation.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@payloadcms/db-postgres": "3.85.0",
    "@payloadcms/next": "3.85.0",
    "@payloadcms/richtext-lexical": "3.85.0",
    "@payloadcms/ui": "3.85.0",
    "cross-env": "10.1.0",
    "graphql": "^16.14.1",
    "next": "16.2.7",
    "payload": "3.85.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
