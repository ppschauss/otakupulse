# --- Dependencies & Build ---
frontend/node_modules/
frontend/.next/
frontend/.next.bak/
frontend/build/
frontend/.turbo/

# --- Secrets & lokale Config (NIEMALS committen) ---
secrets.env
.env
*.env.local

# --- PostgreSQL-Datenverzeichnis (Volume, root-owned) ---
db/

# --- n8n-Laufzeitdaten + Credentials (Volume) — Workflows liegen versioniert in n8n-workflows/ ---
n8n/
# Roh-Exporte aus der n8n-DB: enthalten hartkodierte Tokens im Klartext.
n8n-workflows/_backup-*/

# --- Social-Agent: Laufzeit-DB ---
social/data/

# --- Gespiegelte Bilder (groß: ~4 GB / 61k Dateien) ---
# Beim Stagen via rsync/Volume übertragen oder mit `npm run mirror` neu erzeugen.
frontend/public/media/

# --- Logs / OS / Editor ---
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# TS build info
*.tsbuildinfo

# rclone (enthält Offsite-Credentials) + Binary
rclone.conf
bin/

# --- Ad-hoc-Backups von Config-Dateien ---
*.bak-*
